  "url_patterns": {
    "analysis_page": "/analysis/{scheduleID}cn.htm",
    "league_page": {
      "League": "/cn/League/{season}/{id}.html",
      "SubLeague": "/cn/SubLeague/{season}/{id}.html"
    },
    "cup_listing_page": "/cn/CupMatch/{id}.html",
    "js_data": {
      "league": "/jsData/matchResult/{season}/s{id}.js",
      "league_subid": "/jsData/matchResult/{season}/s{id}_{subId}.js",
      "cup": "/jsData/matchResult/{season}/c{id}.js",
      "season": "/jsData/LeagueSeason/sea{id}.js"
    },
    "note_js_data_paths": "联赛先用s{id}.js; 若返回404或无jh数据则从赛季页HTML发现subId后用s{id}_{subId}.js. 杯赛固定用c{id}.js. 所有JS请求需带Referer+version参数.",
    "subId_discovery": "从赛季页(/cn/League/{season}/{id}.html或/cn/SubLeague/{season}/{id}.html)的<script>标签中提取s{id}_{subId}.js路径中的subId",
    "analysis_data": "/default/getScheduleInfo?sid={scheduleID}",
    "js_with_version_and_referer": true
  },
  "crawler_notes": {
    "anti_crawl": [
      "JS数据文件需要带 Referer 和随机 version 参数（如 ?version=2026072201）",
      "analysis 页面反爬较重，建议用 Playwright 渲染后提取 JS 变量和 DOM",
      "部分旧赛季 JS 数据文件可能 404（如苏超ID=29），需处理重试和降级策略",
      "随机 User-Agent 和请求间隔 1-3 秒"
    ],
    "method": "混合策略：requests获取赛程数据 + Playwright渲染Analysis页",
    "season_format_explanation": {
      "cross_year": "YYYY-YYYY格式，如 2025-2026（适用于英超、德甲等欧洲联赛）",
      "single_year": "YYYY格式，如 2026（适用于美职联、挪超、瑞典超、芬超等春季-秋季联赛）",
      "mixed": "最新赛季为跨年，旧赛季为单年（日职联、日职乙从2026-2027起转跨年）"
    },
    "user_range_meaning": {
      "15/16-25/26_for_cross_year": "从2015-2016到2025-2026共11个赛季",
      "15/16-25/26_for_single_year": "从2015到2026共12个赛季（对应跨年范围的起止年份）",
      "15/16-25/26_for_mixed": "单年格式列出（2015-2026），最新跨年赛季2026-2027已超出范围"
    },
    "analysis_page_versions": {
      "V1_15_16": "id='odds_top'头模板, 16列h_data, 无天气区域, 有'上一场阵容'单表, 积分表用词'得分'",
      "V1_5_transition_16_17": "id='odds_top2'过渡头, 18列h_data, 其余同V1",
      "V1_5_17_20": "id='odds_top2', 20列h_data, 无天气(17-19)/有天气(19-20), 单表阵容",
      "V2_20_23": "class='header'新版头, 20列h_data, 有天气, 嵌套表阵容+球员链接, 积分表'得分'+'积分'",
      "V2_5_23_24": "class='header', 20列, 积分表仅用'积分'(无'得分'), 无VIP区",
      "V3_24_25": "class='header'+'analyhead new', 20-22列h_data, 有VIP方案区, 部分无'上一场阵容'",
      "V3_1_25_26": "同V3, 22列扩展(部分联赛), 整合评分等新元素"
    },
    "key_version_markers": {
      "header_type": "最可靠: id='odds_top'→V1, id='odds_top2'→V1.5, class='header'→V2, 'analyhead new'→V3",
      "standings_terminology": "V1-V2同时'得分'+'积分'; V2.5+仅'积分'",
      "prev_lineup": "V1-V2有'上一场阵容'; V3部分联赛无",
      "weather": "V1-V1.5a无天气; V1.5c(19/20)+有天气",
      "vip": "V3有VIP方案区; V1-V2.5无"
    },
    "reliable_markers": [
      "头模板类型(id='odds_top'/'odds_top2'/class='header'/analyhead new) → 最可靠的版本标识",
      "h_data列数 → 辅助判定(16/18/20/22), 但同版本内可能有杂项差异",
      "积分表用词('得分'/'积分') → V2.5分界点",
      "VIP区 → V3标志"
    ],
    "analysis_page_sections": {
      "match_info_js_vars": "hometeam, guestteam, strTime, scheduleID (JS变量, 所有版本通用)",
      "match_info_weather": "天气/温度 (V1.5c+才有)",
      "recent_matches_js": "JS变量 h_data(主队), a_data(客队), h2_data(主队主场), a2_data(客队客场), v_data(对赛) (所有版本通用, 列数因版本而异)",
      "league_standings": "HTML表格(主客队联赛排名), 表头用词'得分'(V1-V2)/'积分'(V2.5+)",
      "lineup": "HTML区域: V1单表无球员链接, V2嵌套表+球员链接, V3整合评分",
      "head_to_head": "HTML表格 vsOld(历史交锋)+vsNew(近期交锋)",
      "match_preview": "HTML文本区域(赛前简报), V1内联, V2动态加载, V3表格+动态"
    }
