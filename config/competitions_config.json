      "V2.5": "2023-2024：20列, class='header', 积分表仅用'积分'(无'得分'), 无VIP",
      "V3": "2024-2025：20列(某些联赛22列), class='header'+'analyhead new', 有VIP, 部分联赛无'上一场阵容'",
      "V3.1": "2025-2026：22列(部分联赛), 'analyhead new', VIP, 新赛季进一步扩展"
    }
